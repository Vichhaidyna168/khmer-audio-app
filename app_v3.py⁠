[F] កម្មវិធីនេះដំណើរការលឿន និងស្រួលប្រើប្រាស់មែនទែន។"""


def clean_srt_text(text):
    text = re.sub(r"\[[EMF]\]\s*", "", text)
    return text.strip()


def extract_srt_only(text):
    if not text:
        return ""
    match = re.search(r'(?:^|\n)(\d+\s*[\r\n]+\d\d:\d\d:\d\d)', text)
    if match:
        text = text[match.start():]
    text = re.sub(r"^```(srt)?\n?", "", text, flags=re.MULTILINE)
    text = re.sub(r"\n?```$", "", text, flags=re.MULTILINE)
    return text.strip()


def get_audio_duration(file_path):
    """ វាស់ប្រវែងវិនាទីពិតប្រាកដនៃ Sound File ដោយប្រើ FFprobe """
    cmd = [
        "ffprobe", "-v", "error",
        "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1",
        file_path
    ]
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        return float(res.stdout.strip())
    except Exception:
        return 0.0


def process_audio_segment_ffmpeg(text_bytes, target_duration, start_time, current_timeline):
    """
    🔑 ប្រព័ន្ធ Engine V2: គណនាចន្លោះទំនេរ និងតម្រូវ Timecode ឱ្យស៊ីគ្នាម៉ាត់ៗជាមួយ SRT
    """
    if not text_bytes:
        return b"", current_timeline

    in_f = tempfile.NamedTemporaryFile(delete=False, suffix=".mp3")
    in_f.write(text_bytes)
    in_f.close()

    out_f = tempfile.mktemp(suffix=".mp3")
    
    actual_dur = get_audio_duration(in_f.name)
    
    # ១. គណនា Silence Gap (ចង្វាក់ដកដង្ហើម/ចន្លោះទំនេរ) មុនចាប់ផ្តើមប្រយោគ
    gap_before = max(0.0, start_time - current_timeline)
    
    # ២. កំណត់ filter សម្រាប់កែប្រែ Silence Pad ឬ Speed
    filters = []
    if gap_before > 0.01:
        # បន្ថែម Silence ខាងមុខប្រយោគ ដើម្បីឱ្យត្រូវ Timecode ចាប់ផ្តើម
        gap_ms = int(gap_before * 1000)
        filters.append(f"adelay={gap_ms}|{gap_ms}")
    
    # ប្រសិនបើសំឡេងនិយាយវែងជាង SRT Window ខ្លាំង ធ្វើការ Speed Up បន្តិច
    if actual_dur > target_duration and target_duration > 0.5:
        speed_factor = min(2.0, actual_dur / target_duration)
        filters.append(f"atempo={speed_factor:.2f}")

    if filters:
        filter_str = ",".join(filters)
        cmd = [
            "ffmpeg", "-y", "-i", in_f.name,
            "-af", filter_str,
            "-c:a", "libmp3lame", "-b:a", "128k", "-ar", "44100",
            out_f
        ]
    else:
        cmd = [
            "ffmpeg", "-y", "-i", in_f.name,
            "-c:a", "libmp3lame", "-b:a", "128k", "-ar", "44100",
            out_f
        ]

    try:
        subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
        if os.path.exists(out_f):
            with open(out_f, "rb") as f:
                res_data = f.read()
            new_dur = get_audio_duration(out_f)
            new_timeline = current_timeline + gap_before + (new_dur if new_dur > 0 else actual_dur)
            os.remove(in_f.name)
            os.remove(out_f)
            return res_data, new_timeline
    except Exception:
        pass

    os.remove(in_f.name)
    if os.path.exists(out_f):
        os.remove(out_f)
    return text_bytes, current_timeline + gap_before + actual_dur


def generate_precise_synced_audio(srt_raw_text):
    clean_srt_input = extract_srt_only(srt_raw_text)
    try:
        subs = list(srt.parse(clean_srt_input))
    except Exception:
        raise Exception("ទម្រង់ SRT មានបញ្ហា! សូមពិនិត្យមើលលេខរៀង និង Timecode នៃ SRT ឡើងវិញ។")

    if not subs:
        return None

    combined_bytes = bytearray()
    current_timeline = 0.0
    total_subs = len(subs)
    
    progress_bar = st.progress(0)
    status_text = st.empty()

    for idx, sub in enumerate(subs):
        start_sec = sub.start.total_seconds()
        end_sec = sub.end.total_seconds()
        target_duration = max(0.5, end_sec - start_sec)
        cleaned_text = clean_srt_text(sub.content.strip())

        status_text.markdown(f"🎙️ **Engine V2: កំពុងតម្រូវចង្វាក់ដកដង្ហើមផ្នែកទី {idx+1}/{total_subs}...**")

        if cleaned_text:
            try:
                tts = gTTS(text=cleaned_text, lang="km", slow=False)
                fp = io.BytesIO()
                tts.write_to_fp(fp)
                raw_chunk = fp.getvalue()
                
                # Processing តាមរយៈ FFmpeg Engine V2
                processed_chunk, current_timeline = process_audio_segment_ffmpeg(
                    raw_chunk, target_duration, start_sec, current_timeline
                )
                combined_bytes.extend(processed_chunk)
            except Exception:
                pass

        percent_complete = int((idx + 1) / total_subs * 100)
        progress_bar.progress(percent_complete)

    status_text.empty()
    return bytes(combined_bytes)


