# Helper Functions
# ==========================================
def extract_clean_text(srt_string):
    lines = srt_string.split('\n')
    text_lines = []
    for line in lines:
        line_s = line.strip()
        if not line_s.isdigit() and '-->' not in line_s and line_s != '':
            clean_line = re.sub(r'\[.*?\]', '', line_s).strip()
            if clean_line:
                text_lines.append(clean_line)
    return " ".join(text_lines)

async def generate_edge_tts_audio(text, voice, output_filename):
    communicate = edge_tts.Communicate(text, voice)
    await communicate.save(output_filename)

def call_gemini_ai(prompt_text, api_key, model_name):
    genai.configure(api_key=api_key)
    model = genai.GenerativeModel(model_name)
    response = model.generate_content(prompt_text)
    return response.text

