
import streamlit as st

st.set_page_config(page_title="AI Video Dubbing", page_icon="🎬", layout="wide")

st.title("🎬 AI Video Dubbing App")
st.write("ស្វាគមន៍មកកាន់កម្មវិធី AI Video Dubbing")

with st.sidebar:
    st.header("🌐 Target Language")
    language = st.selectbox("ជ្រើសរើសភាសា", ["Khmer", "English"])
    st.markdown("---")
    st.header("🔑 API Keys Manager")
    api_key = st.text_input("Paste Gemini API Key", type="password")
    if not api_key:
        st.warning("⚠️ សូមបញ្ចូល API Key ក្នុងប្រអប់ខាងលើ!")

tabs = st.tabs(["Upload Video", "Processing", "Export"])

with tabs[0]:
    st.subheader("១. បញ្ចូលវីដេអូ (Upload Video)")
    uploaded_file = st.file_uploader("ជ្រើសរើសវីដេអូ ឬសំឡេង", type=["mp4", "mp3", "wav"])
    if uploaded_file:
        st.video(uploaded_file)

with tabs[1]:
    st.subheader("២. បំប្លែង និងបកប្រែ")
    if st.button("ចាប់ផ្តើមបកប្រែ (Start Dubbing)"):
        st.success("កំពុងដំណើរការ...")

with tabs[2]:
    st.subheader("៣. លទ្ធផលចុងក្រោយ")
    st.write("វីដេអូដែលបានបញ្ចូលសំឡេងរួចរាល់នឹងបង្ហាញនៅទីនេះ។")
