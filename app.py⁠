import streamlit as st
import asyncio
import edge_tts
import tempfile
import os
import re
from pydub import AudioSegment
from google import genai

st.set_page_config(
    page_title="Vichhai Dubber Pro",
    page_icon="🎬",
    layout="wide"
)

# ----------------- SESSION STATE -----------------
if "srt_text" not in st.session_state:
    st.session_state.srt_text = ""
if "audio_path" not in st.session_state:
    st.session_state.audio_path = None

# ----------------- SIDEBAR -----------------
with st.sidebar:
    st.header("👋 Vichhai Dubber Pro")
    st.text("ROLE: ADMIN_USER")
    st.text("PLAN: 2026-12-31")
    
    if st.button("🚪 ចាកចេញ (Logout)", key="logout"):
        st.session_state.clear()
        st.rerun()

    st.divider()
    target_lang = st.selectbox("🌐 Target Language:", ["Khmer (ខ្មែរ)", "English", "Thai", "Chinese"])
    api_key = st.text_input("🔑 Paste Gemini API Key", type="password", placeholder="AIzaSy...")
    trans_style = st.radio("🎭 Translation Style", ["Gemini Api", "Google Api"])
    sync_mode = st.radio("⚙️ Audio Sync Mode", ["Speed Up Only (លឿន)", "Speed Up & Slow Down"])
    voice_mode = st.radio("🗣️ Voice Mode", ["Auto (ប្រុស/ស្រី)", "All Male", "All Female"], index=0)
    ai_model = st.selectbox("🧠 AI Model", ["gemini-2.5-flash", "gemini-2.5-pro", "gemini-1.5-flash"])

# ----------------- MAIN CONTENT -----------------
st.title("🎬 Vichhai Dubber Pro")
tab1, tab2, tab3 = st.tabs(["🎬 AI Video Dubbing", "🌐 AI SRT Translator", "📜 Subtitle to Audio"])

# Helper function for Edge TTS
async def text_to_speech(text, voice, output_file):
    communicate = edge_tts.Communicate(text, voice)
    await communicate.save(output_file)

with tab1:
    st.subheader("1️⃣ Generate Subtitles (Khmer (ខ្មែរ))")
    uploaded_video = st.file_uploader("Upload Video", type=["mp4", "mov", "avi", "mkv"])
    
    if uploaded_video is not None:
        st.video(uploaded_video)
        
        if st.button("🚀 Generate Subtitles (Sync 100%)", type="primary"):
            if not api_key:
                st.error("សូមបញ្ចូល Gemini API Key នៅក្នុង Sidebar ជាមុនសិន!")
            else:
                with st.spinner("កំពុងវិភាគវីដេអូ និងបង្កើត Subtitle SRT..."):
                    try:
                        client = genai.Client(api_key=api_key)
                        with tempfile.NamedTemporaryFile(delete=False, suffix=".mp4") as tmp_vid:
                            tmp_vid.write(uploaded_video.read())
                            video_path = tmp_vid.name
                        
                        uploaded_file = client.files.upload(file=video_path)
                        prompt = "Generate exact Khmer SRT subtitles for this video. Include character voice tags like [M] for Male and [F] for Female at the beginning of spoken text lines."
                        
                        response = client.models.generate_content(
                            model=ai_model,
                            contents=[uploaded_file, prompt]
                        )
                        
                        st.session_state.srt_text = response.text
                        st.success("✅ SRT Generation Complete!")
                        os.remove(video_path)
                    except Exception as e:
                        st.session_state.srt_text = (
                            "1\n00:00:00,205 --> 00:00:02,500\n[F] អាប្រុសស្រីក្រមកពីភ្នំដូចឯង សក្តិសមជាគូដណ្តឹងខ្ញុំដែរឬ?\n\n"
                            "2\n00:00:06,309 --> 00:00:10,500\n[F] ពិតជាថោកទាបស៊ីសាច់ក្ដានមែន មិនចេះឆ្លុះកញ្ចក់មើលខ្លួនឯងសោះ!\n\n"
                            "3\n00:00:10,600 --> 00:00:13,800\n[M] មែនហើយ លោកប្រុសវ៉ាង និងកញ្ញាស៊ូ ទើបជាគូស្ករសមគ្នាបំផុត ghosts."
                        )
                        st.warning(f"ប្រើប្រាស់ទិន្នន័យគំរូ (API error: {e})")

    st.markdown("### Generated SRT from Video")
    st.caption("ពិនិត្យ និងកែសម្រួលអត្ថបទ SRT ទីនេះមុនពេលបញ្ចូលសំឡេង៖")
    
    st.session_state.srt_text = st.text_area(
        "SRT Content", 
        value=st.session_state.srt_text, 
        height=200, 
        label_visibility="collapsed"
    )

    st.divider()

    st.subheader("2️⃣ AI Dubbing (Edge TTS Studio)")
    
    # ប៊ូតុង Clear ដាក់បង្ហាញនៅត្រង់នេះ
    if st.button("🗑️ ធ្វើថ្មី / លុបចោល (Clear Project)"):
        st.session_state.srt_text = ""
        st.session_state.audio_path = None
        st.rerun()

    st.write("")

    if st.button("🎙️ Generate Dubbed Audio (MP3)", type="primary"):
        if not st.session_state.srt_text.strip():
            st.warning("មិនមានអត្ថបទ SRT សម្រាប់បង្កើតសំឡេងទេ!")
        else:
            with st.spinner("កំពុងបំប្លែងអត្ថបទទៅជាសំឡេងប្រុស/ស្រី និងផ្គុំបញ្ចូលគ្នា..."):
                try:
                    male_voice = "km-KH-PisethNeural"
                    female_voice = "km-KH-SreymomNeural"
                    
                    combined_audio = AudioSegment.silent(duration=0)
                    lines = st.session_state.srt_text.splitlines()
                    
                    for line in lines:
                        line_str = line.strip()
                        if not line_str or line_str.isdigit() or "-->" in line_str:
                            continue
                        
                        selected_voice = female_voice
                        if "All Male" in voice_mode:
                            selected_voice = male_voice
                        elif "All Female" in voice_mode:
                            selected_voice = female_voice
                        else:
                            if any(tag in line_str for tag in ["[M]", "[m]", "[Male]", "[ប្រុស]", "M:"]):
                                selected_voice = male_voice
                            elif any(tag in line_str for tag in ["[F]", "[f]", "[Female]", "[ស្រី]", "F:"]):
                                selected_voice = female_voice
                        
                        clean_text = re.sub(r'\[.*?\]', '', line_str)
                        clean_text = re.sub(r'^(M|F|Male|Female|ប្រុស|ស្រី):', '', clean_text).strip()
                        
                        if clean_text:
                            with tempfile.NamedTemporaryFile(delete=False, suffix=".mp3") as tmp_seg:
                                seg_path = tmp_seg.name
                            
                            asyncio.run(text_to_speech(clean_text, selected_voice, seg_path))
                            segment_audio = AudioSegment.from_file(seg_path)
                            combined_audio += segment_audio + AudioSegment.silent(duration=350)
                            os.remove(seg_path)

                    with tempfile.NamedTemporaryFile(delete=False, suffix=".mp3") as tmp_final:
                        final_path = tmp_final.name
                        combined_audio.export(final_path, format="mp3")
                        st.session_state.audio_path = final_path

                    st.success("✅ Audio Dubbing Complete!")
                except Exception as e:
                    st.error(f"កើតមានបញ្ហា៖ {e}")

    if st.session_state.audio_path and os.path.exists(st.session_state.audio_path):
        st.audio(st.session_state.audio_path, format="audio/mp3")
        
        st.markdown("### 💾 Download Options")
        custom_name = st.text_input("បញ្ចូលឈ្មោះ File ដែលអ្នកចង់បាន (Optional):", placeholder="ឧទាហរណ៍: Episode_01_Dubbed")
        filename = custom_name.strip() if custom_name.strip() else "AI_Dubbed_Output"
        
        with open(st.session_state.audio_path, "rb") as f:
            st.download_button(
                label=f"🎵 Download MP3 ({filename}.mp3)",
                data=f,
                file_name=f"{filename}.mp3",
                mime="audio/mp3",
                type="primary"
            )

with tab2:
    st.info("🌐 មុខងារបកប្រែឯកសារ SRT ស្វ័យប្រវត្តិ")

with tab3:
    st.info("📜 មុខងារបំប្លែង Subtitle ទៅជាសំឡេង MP3")


